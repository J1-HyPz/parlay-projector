# ---------------------------------------------------------------------------
# Parlay Projector — application environment
#
# Copy to `.env` for local development. `.env*` files are git-ignored; only
# this example file is committed. It must never contain real secrets.
# ---------------------------------------------------------------------------

# Local development server port (`pnpm dev`).
APP_PORT=3000

# Production server (container). The standalone server reads both.
PORT=3000
HOST=0.0.0.0

# Public origin used for absolute metadata/OpenGraph URLs.
# Set this to the URL the app is actually reached on, e.g.
#   http://truenas.lan:3000        (direct)
#   https://parlay.example.com     (behind a reverse proxy)
SITE_URL=http://localhost:3000

# Build target for `pnpm build`: `node` (default, used by the container) or
# `cloudflare` (Workers build). Leave unset for normal self-hosted builds.
# DEPLOY_TARGET=node

# ---------------------------------------------------------------------------
# Homepage backend
# ---------------------------------------------------------------------------

# Timezone used to decide which calendar day "today" is for Games Today.
APP_TIMEZONE=Europe/London

# Sports data provider (TheSportsDB).
# SPORTS_API_KEY defaults to TheSportsDB's public test key ("3") when unset,
# which is rate limited. Put a real key here for production use.
# Server-side only - never exposed to the browser.
SPORTS_API_URL=https://www.thesportsdb.com/api/v1/json
SPORTS_API_KEY=
SPORTS_CACHE_TTL_SECONDS=120
SPORTS_TIMEOUT_MS=8000

# Sports news. Comma-separated RSS feeds; headlines, short provider summaries
# and source links only - article bodies are never fetched or stored.
NEWS_FEED_URLS=https://feeds.bbci.co.uk/sport/rss.xml
NEWS_CACHE_TTL_SECONDS=600
NEWS_TIMEOUT_MS=8000

# Directory for persistent data (prediction history lives in
# $DATA_DIR/predictions.json). MUST be a mounted volume in production: a
# container filesystem is ephemeral and would lose history on every redeploy.
DATA_DIR=./data

# Reserved for future application phases. Leave blank in this prototype.
DATABASE_URL=

# ---------------------------------------------------------------------------
# NOT application configuration:
# TrueNAS deployment credentials (TRUENAS_HOST / TRUENAS_API_KEY / ...) are
# CI-only values. They live in GitHub repository secrets and are consumed by
# .github/workflows/deploy-truenas.yml. They must never be added to this file,
# to a .env file, or to the container image.
# ---------------------------------------------------------------------------
