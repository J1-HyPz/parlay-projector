# ---------------------------------------------------------------------------
# Parlay Projector — application environment
#
# Copy to `.env` for local development. `.env*` files are git-ignored; only
# this example file is committed. It must never contain real secrets.
# ---------------------------------------------------------------------------

# Local development server port (`pnpm dev`).
APP_PORT=3000

# Production server (container). The standalone server reads both.
PORT=3000
HOST=0.0.0.0

# Public origin used for absolute metadata/OpenGraph URLs.
# Set this to the URL the app is actually reached on, e.g.
#   http://truenas.lan:3000        (direct)
#   https://parlay.example.com     (behind a reverse proxy)
SITE_URL=http://localhost:3000

# Build target for `pnpm build`: `node` (default, used by the container) or
# `cloudflare` (Workers build). Leave unset for normal self-hosted builds.
# DEPLOY_TARGET=node

# ---------------------------------------------------------------------------
# Homepage backend
# ---------------------------------------------------------------------------

# Timezone used to decide which calendar day "today" is for Games Today.
APP_TIMEZONE=Europe/London

# Sports data provider (TheSportsDB).
# SPORTS_API_KEY defaults to TheSportsDB's public test key ("3") when unset,
# which is rate limited. Put a real key here for production use.
# Server-side only - never exposed to the browser.
SPORTS_API_URL=https://www.thesportsdb.com/api/v1/json
SPORTS_API_KEY=
SPORTS_TIMEOUT_MS=8000

# Request throttling adapts automatically to the key above: the public test key
# gets conservative limits, any real key gets higher concurrency and shorter
# caches. Set these only to override that for a tier with different limits.
#   test key -> concurrency 4,  schedule cache 900s, today cache 120s
#   premium  -> concurrency 10, schedule cache 300s, today cache  60s
# SPORTS_SCHEDULE_CONCURRENCY=
# SPORTS_SCHEDULE_TTL_SECONDS=
# SPORTS_CACHE_TTL_SECONDS=

# ESPN enrichment provider (team records, recent form, head-to-head,
# broadcast). Requires NO credentials. Set ESPN_ENABLED=false to turn it off;
# every feature degrades cleanly to the primary provider without it.
# See docs/data-providers.md for the licensing caveat.
ESPN_ENABLED=true
ESPN_CACHE_TTL_SECONDS=900
ESPN_TIMEOUT_MS=8000

# Sports news. Comma-separated RSS feeds; headlines, short provider summaries
# and source links only - article bodies are never fetched or stored.
NEWS_FEED_URLS=https://feeds.bbci.co.uk/sport/rss.xml
NEWS_CACHE_TTL_SECONDS=600
NEWS_TIMEOUT_MS=8000

# Live scoreboard. Server-side cache keeps simultaneous clients sharing one
# provider refresh; the poll interval is sent to the browser in the response
# (floored at 10s so misconfiguration cannot hammer the provider).
LIVE_CACHE_TTL_SECONDS=20
LIVE_REFRESH_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Discord notifications
# ---------------------------------------------------------------------------

# Webhook the app posts game updates to. THIS IS A CREDENTIAL: anyone holding
# the URL can post to your channel. Leave it EMPTY in this committed file and
# set the real value in the app environment only (TrueNAS -> Edit -> Environment
# Variables). Never commit it, and rotate it in Discord if it leaks.
#
# Notifications are off entirely when this is unset.
DISCORD_WEBHOOK_URL=

# Only games on the watchlist are announced; an empty watchlist sends nothing.
# Star games in the UI - there is no environment variable for the list itself.
#
# Which transitions to announce, comma-separated.
#   kickoff    a game starts
#   final      a game finishes, with the score
#   postponed  a game is postponed
#   cancelled  a game is cancelled
# An empty value sends nothing while still tracking state.
NOTIFY_EVENTS=kickoff,final,postponed,cancelled

# How often the poller compares today's fixtures against the last seen state.
# Floored at 60s; the underlying fixture fetch is cached for minutes anyway.
NOTIFY_POLL_INTERVAL_MS=300000

# Ceiling on games announced in one poll, so a backlog cannot flood the channel.
NOTIFY_MAX_PER_POLL=20
NOTIFY_TIMEOUT_MS=8000

# Public base URL used to link each notification to its game page. Leave empty
# to send messages without links - a relative path is useless in a chat client.
# e.g. http://truenas.lan:3000
APP_BASE_URL=

# Directory for persistent data (prediction history in
# $DATA_DIR/predictions.json, notification state in $DATA_DIR/notify-state.json,
# the notification watchlist in $DATA_DIR/watchlist.json).
# MUST be a mounted volume in production: a container filesystem is ephemeral
# and would lose history on every redeploy.
DATA_DIR=./data

# Reserved for future application phases. Leave blank in this prototype.
DATABASE_URL=

# ---------------------------------------------------------------------------
# NOT application configuration:
# TrueNAS deployment credentials (TRUENAS_HOST / TRUENAS_API_KEY / ...) are
# CI-only values. They live in GitHub repository secrets and are consumed by
# .github/workflows/deploy-truenas.yml. They must never be added to this file,
# to a .env file, or to the container image.
# ---------------------------------------------------------------------------
